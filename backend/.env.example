# Gemini API key (never commit a real key)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini model id. Default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=5000

# development | production. In production CORS has no default origins and DEMO_MODE is ignored.
NODE_ENV=development

# Comma-separated allowed browser origins. Unset: localhost:5173 and 127.0.0.1:5173 outside production, none in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse-proxy hops to trust for client IPs (rate limiting). Leave unset/false locally; use 1 behind Render/Railway/Heroku/Nginx.
TRUST_PROXY=false

# Rate limit for POST /api/chat (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Request limits
BODY_LIMIT=128kb
CHAT_MAX_MESSAGE_LENGTH=1000
CHAT_MAX_HISTORY=20
CHAT_MAX_HISTORY_CONTENT_LENGTH=4000
GEMINI_TIMEOUT_MS=25000

# Opt-in demo mode: canned answers when no valid GEMINI_API_KEY is set. Ignored when NODE_ENV=production.
DEMO_MODE=false